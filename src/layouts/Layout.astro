---
import { ViewTransitions } from "astro:transitions";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Nisc - Full-stack Developer Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: "Inter", system-ui, sans-serif;
    background: #121317;
    background-image: radial-gradient(
        ellipse at top,
        rgba(109, 40, 217, 0.1),
        transparent
      ),
      radial-gradient(ellipse at bottom, rgba(147, 51, 234, 0.1), transparent);
    background-size: 100% 100%;
    background-attachment: fixed;
    scroll-behavior: smooth;
  }

  body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
  }

  ::selection {
    background-color: rgba(147, 51, 234, 0.3);
    color: #ffffff;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #121317;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #d8b4fe, #7e22ce);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #c084fc, #6d28d9);
  }

  /* Animated cursor effect */
  .custom-cursor {
    position: fixed;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgba(216, 180, 254, 0.5);
    pointer-events: none;
    mix-blend-mode: difference;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s ease;
  }

  /* Page transitions */
  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  main {
    animation: fadeIn 0.5s ease-out forwards;
    width: 100%;
    max-width: 100%;
  }

  /* Responsive container adjustments */
  @media (min-width: 768px) {
    .container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 1280px) {
    .container {
      padding-left: 4rem;
      padding-right: 4rem;
    }
  }
</style>

<script>
  // Custom cursor effect
  document.addEventListener("DOMContentLoaded", () => {
    // Create cursor element
    const cursor = document.createElement("div");
    cursor.classList.add("custom-cursor");
    document.body.appendChild(cursor);

    // Update cursor position
    document.addEventListener("mousemove", (e) => {
      cursor.style.left = `${e.clientX}px`;
      cursor.style.top = `${e.clientY}px`;
    });

    // Scale cursor on click
    document.addEventListener("mousedown", () => {
      cursor.style.transform = "translate(-50%, -50%) scale(1.5)";
    });

    document.addEventListener("mouseup", () => {
      cursor.style.transform = "translate(-50%, -50%) scale(1)";
    });

    // Hide cursor when it leaves the window
    document.addEventListener("mouseleave", () => {
      cursor.style.opacity = "0";
    });

    document.addEventListener("mouseenter", () => {
      cursor.style.opacity = "1";
    });

    // Enhance cursor when hovering over links or buttons
    const interactiveElements = document.querySelectorAll("a, button");
    interactiveElements.forEach((el) => {
      el.addEventListener("mouseenter", () => {
        cursor.style.transform = "translate(-50%, -50%) scale(1.5)";
        cursor.style.mixBlendMode = "normal";
        cursor.style.backgroundColor = "rgba(216, 180, 254, 0.8)";
      });

      el.addEventListener("mouseleave", () => {
        cursor.style.transform = "translate(-50%, -50%) scale(1)";
        cursor.style.mixBlendMode = "difference";
        cursor.style.backgroundColor = "rgba(216, 180, 254, 0.5)";
      });
    });
  });
</script>
