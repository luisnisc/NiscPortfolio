---

---

<div id="canvas-container" class="absolute inset-0 z-[-1] opacity-70"></div>

<script>
  import * as THREE from "three";
  import { gsap } from "gsap";

  let scene, camera, renderer;
  let nucleus,
    orbits = [],
    electrons = [];
  let mouseX = 0,
    mouseY = 0;

  function init() {
    // Scene setup
    scene = new THREE.Scene();

    // Camera setup
    camera = new THREE.PerspectiveCamera(
      75,
      window.innerWidth / window.innerHeight,
      0.1,
      1000
    );
    camera.position.z = 15;

    // Renderer setup
    const container = document.getElementById("canvas-container");
    renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    // Create nucleus
    createNucleus();

    // Create electron orbits and electrons
    createOrbits();

    // Additional ambient light
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);

    // Directional light for some shadows
    const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.position.set(5, 5, 5);
    scene.add(directionalLight);

    // Mouse movement listener
    document.addEventListener("mousemove", onMouseMove);

    // Window resize handling
    window.addEventListener("resize", onWindowResize);

    animate();
  }

  function createNucleus() {
    // Create nucleus (core) of the atom
    const nucleusGeometry = new THREE.IcosahedronGeometry(2, 4);
    const nucleusMaterial = new THREE.ShaderMaterial({
      uniforms: {
        time: { value: 0 },
      },
      vertexShader: `
        varying vec2 vUv;
        varying vec3 vNormal;
        uniform float time;
        
        void main() {
          vUv = uv;
          vNormal = normal;
          
          // Add subtle waviness to the nucleus
          vec3 pos = position;
          float waveStrength = 0.05;
          pos.x += sin(pos.y * 4.0 + time) * waveStrength;
          pos.y += sin(pos.z * 4.0 + time) * waveStrength;
          pos.z += sin(pos.x * 4.0 + time) * waveStrength;
          
          gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
        }
      `,
      fragmentShader: `
        varying vec2 vUv;
        varying vec3 vNormal;
        uniform float time;
        
        void main() {
          // Blue gradient based on normals and time
          vec3 color1 = vec3(0.3, 0.5, 0.9); // Light blue
          vec3 color2 = vec3(0.1, 0.2, 0.5); // Dark blue
          
          vec3 baseColor = mix(color1, color2, 0.5 + 0.5 * sin(vNormal.x * 5.0 + time * 0.5));
          
          // Add a subtle glow effect
          float glowAmount = pow(0.7 - dot(vNormal, vec3(0, 0, 1.0)), 3.0);
          vec3 glowColor = vec3(0.5, 0.7, 1.0);
          vec3 finalColor = mix(baseColor, glowColor, glowAmount * 0.3);
          
          gl_FragColor = vec4(finalColor, 0.9);
        }
      `,
      transparent: true,
    });

    nucleus = new THREE.Mesh(nucleusGeometry, nucleusMaterial);
    scene.add(nucleus);
  }

  function createOrbits() {
    // Create 3 electron orbits at different angles
    const orbitAngles = [
      { x: 0, y: 0, z: 0 },
      { x: Math.PI / 3, y: Math.PI / 6, z: 0 },
      { x: Math.PI / 6, y: Math.PI / 3, z: Math.PI / 6 },
    ];

    const orbitRadius = 6;
    const orbitWidth = 0.04;
    const orbitSegments = 64;

    // Different orbit colors for visual interest
    const orbitColors = [
      0x61dafb, // React blue
      0x8a61fb, // Purple
      0xfb61da, // Pink
    ];

    orbitAngles.forEach((angles, index) => {
      const orbit = createOrbit(
        orbitRadius,
        orbitWidth,
        orbitSegments,
        orbitColors[index]
      );
      orbit.rotation.x = angles.x;
      orbit.rotation.y = angles.y;
      orbit.rotation.z = angles.z;
      orbits.push(orbit);
      scene.add(orbit);

      // Add electron to this orbit
      const electron = createElectron(0.5, orbitColors[index]);
      electrons.push({
        mesh: electron,
        orbit: orbit,
        angle: Math.random() * Math.PI * 2,
        speed: 0.01 + Math.random() * 0.01,
        radius: orbitRadius,
      });
      scene.add(electron);
    });
  }

  function createOrbit(radius, tubeWidth, segments, color) {
    const orbitGeometry = new THREE.TorusGeometry(
      radius,
      tubeWidth,
      16,
      segments
    );
    const orbitMaterial = new THREE.MeshBasicMaterial({
      color: color,
      transparent: true,
      opacity: 0.5,
      emissive: color,
      emissiveIntensity: 0.5,
    });

    return new THREE.Mesh(orbitGeometry, orbitMaterial);
  }

  function createElectron(radius, color) {
    const electronGeometry = new THREE.SphereGeometry(radius, 16, 16);
    const electronMaterial = new THREE.MeshBasicMaterial({
      color: color,
      emissive: color,
      emissiveIntensity: 1,
    });

    // Add glow effect to electron
    const glowMaterial = new THREE.ShaderMaterial({
      uniforms: {
        glowColor: { value: new THREE.Color(color) },
      },
      vertexShader: `
        varying vec3 vNormal;
        void main() {
          vNormal = normalize(normalMatrix * normal);
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform vec3 glowColor;
        varying vec3 vNormal;
        void main() {
          float intensity = pow(0.7 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 4.0);
          gl_FragColor = vec4(glowColor, 1.0) * intensity;
        }
      `,
      side: THREE.BackSide,
      blending: THREE.AdditiveBlending,
      transparent: true,
    });

    const electronMesh = new THREE.Mesh(electronGeometry, electronMaterial);

    // Add glow sphere around electron
    const glowGeometry = new THREE.SphereGeometry(radius * 1.5, 16, 16);
    const glowMesh = new THREE.Mesh(glowGeometry, glowMaterial);
    electronMesh.add(glowMesh);

    return electronMesh;
  }

  function onMouseMove(event) {
    // Convert mouse coordinates to normalized values between -1 and 1
    mouseX = (event.clientX / window.innerWidth) * 2 - 1;
    mouseY = -(event.clientY / window.innerHeight) * 2 + 1;

    // Rotate the entire atom based on mouse position
    if (nucleus) {
      gsap.to(scene.rotation, {
        x: mouseY * 0.2,
        y: mouseX * 0.2,
        duration: 1,
        ease: "power2.out",
      });
    }
  }

  function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }

  function animate() {
    requestAnimationFrame(animate);

    // Update nucleus shader time
    if (nucleus.material.uniforms) {
      nucleus.material.uniforms.time.value += 0.01;
    }

    // Rotate nucleus slightly
    nucleus.rotation.x += 0.002;
    nucleus.rotation.y += 0.003;

    // Update electrons position along orbits
    electrons.forEach((electron) => {
      electron.angle += electron.speed;

      // Calculate position on orbit
      const x = electron.radius * Math.cos(electron.angle);
      const y = electron.radius * Math.sin(electron.angle);

      // Apply the same rotation as the orbit
      const rotatedPosition = new THREE.Vector3(x, y, 0);
      rotatedPosition.applyEuler(electron.orbit.rotation);

      electron.mesh.position.set(
        rotatedPosition.x,
        rotatedPosition.y,
        rotatedPosition.z
      );
    });

    renderer.render(scene, camera);
  }

  // Initialize when document is loaded
  document.addEventListener("DOMContentLoaded", init);
</script>
