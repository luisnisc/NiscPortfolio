---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavbarEs.astro";
import AnimatedSphere from "../../components/3d/AnimatedSphere.astro";
import ParticleEffect from "../../components/3d/ParticleEffect.astro";
import AstroIcon from "../../components/icons/AstroIcon.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Nisc | Desarrollador Full-stack">
  <ParticleEffect />
  <AnimatedSphere />
  <Navbar />

  <main class="relative pt-32 md:pt-40 overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="animated-bg absolute inset-0 bg-gradient-to-br from-purple-900/10 via-purple-800/5 to-purple-900/10 opacity-50"
      >
      </div>
      <div
        class="animated-bg-secondary absolute inset-0 bg-gradient-to-tl from-purple-600/10 via-transparent to-purple-700/10 opacity-30"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <section class="flex flex-col items-center text-center">
        <h1
          class="text-5xl md:text-7xl font-bold text-white leading-tight mb-6"
        >
          Bienvenido al <span
            class="inline-block animate-pulse bg-gradient-to-r from-purple-300 to-purple-700 bg-clip-text text-transparent"
            >Portafolio</span
          > de Luis Navascués
        </h1>

        <p
          class="text-lg md:text-xl text-gray-300 max-w-3xl mb-10 leading-relaxed"
        >
          Soy un <span class="text-purple-300 font-medium"
            >desarrollador full-stack</span
          > apasionado por construir aplicaciones web innovadoras. Actualmente estudio
          formación profesional superior en desarrollo web, ampliando constantemente
          mis habilidades y buscando nuevos desafíos que afrontar.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 mb-16"
        >
          <a
            href="/es/projects"
            class="group relative inline-flex items-center justify-center px-8 py-3 font-medium text-white rounded-lg overflow-hidden bg-gradient-to-r from-purple-600 to-purple-900 shadow-md hover:shadow-lg transition-all duration-300 ease-out hover:-translate-y-1"
          >
            <span class="relative z-10">Ver Proyectos</span>
            <span
              class="absolute inset-0 bg-gradient-to-r from-purple-400 to-purple-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
            ></span>
          </a>

          <a
            href="/es/contact"
            class="group relative inline-flex items-center justify-center px-8 py-3 font-medium rounded-lg overflow-hidden border border-purple-500 text-white transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-md"
          >
            <span class="relative z-10">Contáctame</span>
            <span
              class="absolute inset-0 bg-gradient-to-r from-purple-600/30 to-purple-900/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-in-out"
            ></span>
          </a>
        </div>
      </section>

      <section class="mt-16 md:mt-24 mb-20">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10"
        >
          <!-- Skill Card 1 -->
          <div
            class="skill-card bg-[#1a1c23] p-6 rounded-xl border border-purple-900/20 hover:border-purple-500/50 transition-all duration-300 group"
          >
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 flex items-center justify-center bg-purple-900/20 rounded-lg mr-4 group-hover:bg-purple-900/40 transition-colors duration-300"
              >
                <Icon name="mdi:code-tags" class="w-7 h-7 text-purple-400" />
              </div>
              <h3 class="text-xl font-bold text-white">
                Desarrollo Full-Stack
              </h3>
            </div>
            <p class="text-gray-300">
              Creando experiencias fluidas desde el frontend hasta el backend
              utilizando frameworks y tecnologías modernas.
            </p>
          </div>

          <!-- Skill Card 2 -->
          <div
            class="skill-card bg-[#1a1c23] p-6 rounded-xl border border-purple-900/20 hover:border-purple-500/50 transition-all duration-300 group"
          >
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 flex items-center justify-center bg-purple-900/20 rounded-lg mr-4 group-hover:bg-purple-900/40 transition-colors duration-300"
              >
                <Icon name="mdi:responsive" class="w-7 h-7 text-purple-400" />
              </div>
              <h3 class="text-xl font-bold text-white">Diseño Responsive</h3>
            </div>
            <p class="text-gray-300">
              Elaborando interfaces que se ven y funcionan de manera óptima en
              todos los dispositivos y tamaños de pantalla.
            </p>
          </div>

          <!-- Skill Card 3 -->
          <div
            class="skill-card bg-[#1a1c23] p-6 rounded-xl border border-purple-900/20 hover:border-purple-500/50 transition-all duration-300 group"
          >
            <div class="flex items-center mb-4">
              <div
                class="w-12 h-12 flex items-center justify-center bg-purple-900/20 rounded-lg mr-4 group-hover:bg-purple-900/40 transition-colors duration-300"
              >
                <Icon name="mdi:brain" class="w-7 h-7 text-purple-400" />
              </div>
              <h3 class="text-xl font-bold text-white">
                Resolución de Problemas
              </h3>
            </div>
            <p class="text-gray-300">
              Abordando problemas complejos con pensamiento analítico y
              soluciones creativas.
            </p>
          </div>
        </div>
      </section>

      <!-- Tech Stack Section -->
      <section class="mt-16 md:mt-24 mb-16 md:mb-24">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Mi Stack Tecnológico
          </h2>
          <p class="text-lg text-gray-300 max-w-2xl mx-auto">
            Las herramientas y tecnologías que uso para crear experiencias
            digitales excepcionales
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6 mb-12">
          <!-- Frontend Technologies -->
          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:react" class="w-10 h-10 text-cyan-400" />
            </div>
            <span class="tech-label">NextJS</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <AstroIcon class="w-10 h-10" size="40" />
            </div>
            <span class="tech-label">Astro</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon
                name="mdi:language-typescript"
                class="w-10 h-10 text-blue-600"
              />
            </div>
            <span class="tech-label">TypeScript</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:tailwind" class="w-10 h-10 text-teal-400" />
            </div>
            <span class="tech-label">Tailwind CSS</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:motion-play" class="w-10 h-10 text-pink-500" />
            </div>
            <span class="tech-label">Framer Motion</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:cube-outline" class="w-10 h-10 text-orange-400" />
            </div>
            <span class="tech-label">Three.js</span>
          </div>

          <!-- Backend & Tools -->
          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:nodejs" class="w-10 h-10 text-green-500" />
            </div>
            <span class="tech-label">Node.js</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon
                name="mdi:language-python"
                class="w-10 h-10 text-blue-400"
              />
            </div>
            <span class="tech-label">Python</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:database" class="w-10 h-10 text-blue-600" />
            </div>
            <span class="tech-label">MySQL</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:leaf" class="w-10 h-10 text-green-600" />
            </div>
            <span class="tech-label">MongoDB</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:api" class="w-10 h-10 text-purple-500" />
            </div>
            <span class="tech-label">GraphQL</span>
          </div>

          <div class="tech-card group">
            <div class="tech-icon-container">
              <Icon name="mdi:docker" class="w-10 h-10 text-blue-500" />
            </div>
            <span class="tech-label">Docker</span>
          </div>
        </div>

        <!-- Tech Categories -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="tech-category">
            <div class="tech-category-header">
              <Icon
                name="mdi:monitor-dashboard"
                class="w-8 h-8 text-purple-400"
              />
              <h3 class="text-xl font-bold text-white">Frontend</h3>
            </div>
            <div class="tech-category-content">
              <span class="tech-tag">React</span>
              <span class="tech-tag">Astro</span>
              <span class="tech-tag">TypeScript</span>
              <span class="tech-tag">Tailwind CSS</span>
              <span class="tech-tag">Framer Motion</span>
              <span class="tech-tag">Three.js + GSAP</span>
            </div>
          </div>

          <div class="tech-category">
            <div class="tech-category-header">
              <Icon name="mdi:server" class="w-8 h-8 text-purple-400" />
              <h3 class="text-xl font-bold text-white">Backend & APIs</h3>
            </div>
            <div class="tech-category-content">
              <span class="tech-tag">Node.js</span>
              <span class="tech-tag">Python</span>
              <span class="tech-tag">MySQL</span>
              <span class="tech-tag">MongoDB</span>
              <span class="tech-tag">API REST</span>
              <span class="tech-tag">GraphQL</span>
            </div>
          </div>

          <div class="tech-category">
            <div class="tech-category-header">
              <Icon name="mdi:tools" class="w-8 h-8 text-purple-400" />
              <h3 class="text-xl font-bold text-white">
                Herramientas & Plataformas
              </h3>
            </div>
            <div class="tech-category-content">
              <span class="tech-tag">Git & GitHub</span>
              <span class="tech-tag">VS Code</span>
              <span class="tech-tag">Figma</span>
              <span class="tech-tag">Vercel</span>
              <span class="tech-tag">Docker</span>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-24 mb-24 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-8">
          Construyamos Algo Increíble
        </h2>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto mb-10">
          Siempre estoy buscando nuevas oportunidades para aprender, crecer y
          colaborar en proyectos emocionantes.
        </p>
        <div class="flex justify-center gap-6">
          <a
            href="/es/projects"
            class="text-purple-300 hover:text-purple-400 transition-colors"
          >
            <span class="sr-only">Ver Proyectos</span>
            <Icon name="mdi:rocket-launch" class="w-8 h-8" />
          </a>
          <a
            href="/es/education"
            class="text-purple-300 hover:text-purple-400 transition-colors"
          >
            <span class="sr-only">Ver Educación</span>
            <Icon name="mdi:school" class="w-8 h-8" />
          </a>
          <a
            href="/es/contact"
            class="text-purple-300 hover:text-purple-400 transition-colors"
          >
            <span class="sr-only">Contacto</span>
            <Icon name="mdi:email" class="w-8 h-8" />
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Animated Background */
  .animated-bg {
    background-size: 400% 400%;
    animation: gradientMove 20s ease infinite;
  }

  .animated-bg-secondary {
    background-size: 300% 300%;
    animation: gradientMoveReverse 15s ease infinite;
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
      opacity: 0.3;
    }
    25% {
      background-position: 100% 25%;
      opacity: 0.5;
    }
    50% {
      background-position: 100% 50%;
      opacity: 0.4;
    }
    75% {
      background-position: 0% 75%;
      opacity: 0.6;
    }
    100% {
      background-position: 0% 50%;
      opacity: 0.3;
    }
  }

  @keyframes gradientMoveReverse {
    0% {
      background-position: 100% 50%;
      opacity: 0.2;
    }
    25% {
      background-position: 0% 75%;
      opacity: 0.4;
    }
    50% {
      background-position: 0% 50%;
      opacity: 0.3;
    }
    75% {
      background-position: 100% 25%;
      opacity: 0.5;
    }
    100% {
      background-position: 100% 50%;
      opacity: 0.2;
    }
  }

  .skill-card {
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-8px);
  }

  /* Tech Stack Styles */
  .tech-card {
    @apply bg-[#1a1c23] p-6 rounded-xl border border-purple-900/20 hover:border-purple-500/50 transition-all duration-300 cursor-pointer;
    @apply flex flex-col items-center text-center;
    transform: translateY(0) scale(1);
  }

  .tech-card:hover {
    transform: translateY(-5px) scale(1.05);
    @apply shadow-lg shadow-purple-900/20;
  }

  .tech-icon-container {
    @apply mb-3 p-3 rounded-lg bg-gradient-to-br from-purple-900/20 to-purple-900/5;
    @apply group-hover:from-purple-800/30 group-hover:to-purple-900/10 transition-all duration-300;
  }

  .tech-label {
    @apply text-sm font-medium text-gray-300 group-hover:text-white transition-colors duration-300;
  }

  .tech-category {
    @apply bg-[#1a1c23] p-6 rounded-xl border border-purple-900/20 hover:border-purple-500/30 transition-all duration-300;
  }

  .tech-category-header {
    @apply flex items-center gap-3 mb-4;
  }

  .tech-category-content {
    @apply flex flex-wrap gap-2;
  }

  .tech-tag {
    @apply px-3 py-1 bg-purple-900/20 text-purple-300 rounded-full text-sm font-medium;
    @apply hover:bg-purple-800/30 hover:text-purple-200 transition-all duration-200 cursor-default;
  }

  /* Animations */
  .tech-card {
    animation: techCardFloat 6s ease-in-out infinite;
  }

  .tech-card:nth-child(2n) {
    animation-delay: -2s;
  }

  .tech-card:nth-child(3n) {
    animation-delay: -4s;
  }

  @keyframes techCardFloat {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-3px) scale(1);
    }
  }

  .tech-card:hover {
    animation: none;
  }

  @keyframes floatAnimation {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>
