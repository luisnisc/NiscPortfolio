---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavbarEs.astro";
import ParticleEffect from "../../components/3d/ParticleEffect.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contacto">
  <ParticleEffect />
  <Navbar />

  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h1
          class="text-4xl md:text-5xl font-bold text-center mb-8 bg-gradient-to-r from-purple-300 to-purple-700 bg-clip-text text-transparent"
        >
          Contacto
        </h1>

        <p class="text-lg text-gray-300 text-center mb-12">
          Siempre estoy abierto a discutir nuevos proyectos, ideas creativas u
          oportunidades para ser parte de tu visión.
        </p>

        <div
          class="bg-gradient-to-br from-purple-900/30 to-purple-900/10 rounded-xl shadow-xl border border-purple-900/20 overflow-hidden mb-10 flex justify-center items-center"
        >
          <div
            class="contact-card-glow absolute inset-0 bg-gradient-to-r from-purple-500/10 via-transparent to-purple-700/10 opacity-0 transition-opacity duration-700"
          >
          </div>

          <div class="grid grid-cols-1">
            <!-- Contact Information -->
            <div class="p-6 md:p-10">
              <h2 class="text-2xl font-bold text-white mb-6">
                Información de Contacto
              </h2>

              <div class="space-y-6">
                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon
                      name="mdi:email-outline"
                      class="w-6 h-6 text-purple-300"
                    />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">Email</h3>
                    <a
                      href="mailto:contact@nisc.dev"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >luisnisc30mayo2005@gmail.com</a
                    >
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon
                      name="mdi:map-marker-outline"
                      class="w-6 h-6 text-purple-300"
                    />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">Ubicación</h3>
                    <p class="text-gray-300">Zaragoza, España</p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon name="mdi:github" class="w-6 h-6 text-purple-300" />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">GitHub</h3>
                    <a
                      href="https://github.com/luisnisc"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >github.com/luisnisc</a
                    >
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon name="mdi:linkedin" class="w-6 h-6 text-purple-300" />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">LinkedIn</h3>
                    <a
                      href="https://www.linkedin.com/in/luis-navascues-2b9545257/"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >linkedin.com/in/luis-navascues</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Media Section -->
        <div class="text-center">
          <h2 class="text-2xl font-bold text-white mb-6">Sígueme</h2>

          <div class="flex justify-center space-x-6">
            <a
              href="https://github.com/luisnisc"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:github" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://www.linkedin.com/in/luis-navascues-2b9545257/"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:linkedin" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://twitter.com/luis1nisc"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:twitter" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://instagram.com/lu1snisc"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:instagram" class="w-6 h-6 text-purple-300" />
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .contact-card-glow {
    background-size: 400% 400%;
    animation: gradientMove 15s ease infinite;
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
      opacity: 0.1;
    }
    50% {
      background-position: 100% 50%;
      opacity: 0.3;
    }
    100% {
      background-position: 0% 50%;
      opacity: 0.1;
    }
  }

  .social-icon-link:hover .social-icon {
    transform: scale(1.1);
  }
</style>
