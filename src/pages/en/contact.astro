---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavbarEn.astro";
import ParticleEffect from "../../components/3d/ParticleEffect.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <ParticleEffect />
  <Navbar />

  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h1
          class="text-4xl md:text-5xl font-bold text-center mb-8 bg-gradient-to-r from-purple-300 to-purple-700 bg-clip-text text-transparent"
        >
          Get In Touch
        </h1>

        <p class="text-lg text-gray-300 text-center mb-12">
          I'm always open to discussing new projects, creative ideas or
          opportunities to be part of your vision.
        </p>

        <div
          class="bg-[#1a1c23] rounded-xl shadow-xl border border-purple-900/20 overflow-hidden mb-10"
        >
          <div
            class="contact-card-glow absolute inset-0 bg-gradient-to-r from-purple-500/10 via-transparent to-purple-700/10 opacity-0 transition-opacity duration-700"
          >
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2">
            <!-- Contact Information -->
            <div
              class="p-6 md:p-10 bg-gradient-to-br from-purple-900/20 to-transparent"
            >
              <h2 class="text-2xl font-bold text-white mb-6">
                Contact Information
              </h2>

              <div class="space-y-6">
                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon
                      name="mdi:email-outline"
                      class="w-6 h-6 text-purple-300"
                    />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">Email</h3>
                    <a
                      href="mailto:luisnisc30mayo2005@gmail.com"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >luisnisc30mayo2005@gmail.com</a
                    >
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon
                      name="mdi:map-marker-outline"
                      class="w-6 h-6 text-purple-300"
                    />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">Location</h3>
                    <p class="text-gray-300">Zaragoza, Spain</p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon name="mdi:github" class="w-6 h-6 text-purple-300" />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">GitHub</h3>
                    <a
                      href="https://github.com/luisnisc"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >github.com/luisnisc</a
                    >
                  </div>
                </div>

                <div class="flex items-start">
                  <div
                    class="flex-shrink-0 bg-purple-900/30 p-3 rounded-lg mr-4"
                  >
                    <Icon name="mdi:linkedin" class="w-6 h-6 text-purple-300" />
                  </div>
                  <div>
                    <h3 class="text-lg font-medium text-white">LinkedIn</h3>
                    <a
                      href="https://www.linkedin.com/in/luis-navascues-2b9545257/"
                      class="text-purple-300 hover:text-purple-200 transition-colors"
                      >linkedin.com/in/luis-navascues</a
                    >
                  </div>
                </div>
              </div>
            </div>

            <!-- Contact Form -->
            <div class="p-6 md:p-10">
              <h2 class="text-2xl font-bold text-white mb-6">Send a Message</h2>

              <a href="/en/contact/email" class="block w-full group">
                <div
                  class="bg-[#121317] hover:bg-[#16171c] border border-purple-900/30 hover:border-purple-600/50 rounded-lg p-6 transition-all duration-300 transform hover:-translate-y-1"
                >
                  <div class="flex items-center justify-center mb-4">
                    <Icon
                      name="mdi:email-fast-outline"
                      class="w-12 h-12 text-purple-400"
                    />
                  </div>
                  <h3 class="text-xl font-bold text-center text-white mb-2">
                    Email Form
                  </h3>
                  <p class="text-gray-400 text-center">
                    Use the contact form to send me a direct message
                  </p>
                  <div class="mt-4 flex justify-center">
                    <span
                      class="inline-flex items-center text-purple-300 group-hover:text-purple-200 transition-colors"
                    >
                      <span class="mr-2">Open Form</span>
                      <Icon
                        name="mdi:arrow-right"
                        class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                      />
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Social Media Section -->
        <div class="text-center">
          <h2 class="text-2xl font-bold text-white mb-6">Follow Me</h2>

          <div class="flex justify-center space-x-6">
            <a
              href="https://github.com/luisnisc"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:github" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://linkedin.com/in/luis-navascues-2b9545257/"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:linkedin" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://twitter.com/luis1nisc"
              target="_blank"
              class="social-icon-link"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:twitter" class="w-6 h-6 text-purple-300" />
              </div>
            </a>

            <a
              href="https://instagram.com/lu1snisc"
              target="_blank"
              class="social-icon-link hover:cursor-pointer"
            >
              <div
                class="w-12 h-12 rounded-full bg-[#1a1c23] border border-purple-900/30 hover:border-purple-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-900/20"
              >
                <Icon name="mdi:instagram" class="w-6 h-6 text-purple-300" />
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .contact-card-glow {
    background-size: 400% 400%;
    animation: gradientMove 15s ease infinite;
  }

  @keyframes gradientMove {
    0% {
      background-position: 0% 50%;
      opacity: 0.1;
    }
    50% {
      background-position: 100% 50%;
      opacity: 0.3;
    }
    100% {
      background-position: 0% 50%;
      opacity: 0.1;
    }
  }

  .social-icon-link:hover .social-icon {
    transform: scale(1.1);
  }
</style>
